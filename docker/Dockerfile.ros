# Manifest includes linux/amd64 and linux/arm64/v8.
FROM ros:noetic-ros-base-focal@sha256:72b8bc59035dc0a5b8e07aae28c16caa84192971d72d207c72ed734fb1d5e97d
RUN apt-get update && apt-get install -y --no-install-recommends \
    python3-numpy python3-pil ros-noetic-sensor-msgs ros-noetic-rosbag \
    && rm -rf /var/lib/apt/lists/*
ENV PYTHONUNBUFFERED=1 OPENBLAS_NUM_THREADS=1 OMP_NUM_THREADS=1
WORKDIR /demo/catkin_ws
CMD ["sleep", "infinity"]
